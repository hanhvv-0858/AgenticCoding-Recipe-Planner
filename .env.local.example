# ===========================================
# Recipe Planner - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values:
#   cp .env.local.example .env.local
#
# For local development with Supabase CLI:
#   Run `supabase start` to get the anon key and service role key
# ===========================================

# Supabase Configuration
# The URL for your Supabase project (local or hosted)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Public anonymous key - safe to expose in the browser
# Get from `supabase start` output or Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start

# Service role key - server-side only, NEVER expose to the client
# Has full access to all data, bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
# Base URL for the application (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development Mode
NODE_ENV=development
